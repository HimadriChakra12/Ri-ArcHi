#!/bin/bash

# ytdlp-tui-enhanced.sh - Enhanced TUI wrapper for yt-dlp

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Default directory
MUSIC_DIR="$HOME/Music/yt-dlp"

# UI mode: fzf, whiptail, or basic
UI_MODE=""

# Current download metadata
declare -A DOWNLOAD_META

# Detect source from URL
detect_source() {
    local url=$1
    if [[ "$url" == *"youtube.com"* ]] || [[ "$url" == *"youtu.be"* ]]; then
        echo "youtube"
    elif [[ "$url" == *"soundcloud.com"* ]]; then
        echo "soundcloud"
    else
        echo "other"
    fi
}

# Check if URL is playlist
is_playlist() {
    local url=$1
    if [[ "$url" == *"list="* ]] || [[ "$url" == *"playlist"* ]] || [[ "$url" == *"/sets/"* ]]; then
        return 0
    else
        return 1
    fi
}

# Get custom name for download
get_custom_name() {
    local default_name="$1"
    local custom_name

    # UI text → stderr
    echo -e "${CYAN}📝 Custom Name (press Enter to use default)${NC}" >&2
    echo -e "${BLUE}Default: ${YELLOW}$default_name${NC}" >&2

    # Prompt must NOT be inside command substitution
    read -r -p "$(echo -e "${GREEN}✏️  Custom name: ${NC}")" custom_name

    if [ -z "$custom_name" ]; then
        custom_name="$default_name"
    fi

    # ONLY the final value goes to stdout
    printf '%s' "$custom_name"
}

# Check available UI tools
detect_ui() {
    if command -v fzf &> /dev/null; then
        UI_MODE="fzf"
        echo -e "${GREEN}Using fzf for interface${NC}"
    elif command -v whiptail &> /dev/null; then
        UI_MODE="whiptail"
        echo -e "${YELLOW}Using whiptail for interface${NC}"
    else
        UI_MODE="basic"
        echo -e "${BLUE}Using basic interface${NC}"
    fi
}

# Check dependencies
check_dependencies() {
    local missing_deps=()
    
    if ! command -v yt-dlp &> /dev/null; then
        missing_deps+=("yt-dlp")
    fi
    
    if [ ${#missing_deps[@]} -gt 0 ]; then
        echo -e "${RED}Error: Missing dependencies:${NC}"
        for dep in "${missing_deps[@]}"; do
            echo -e "  ${YELLOW}• $dep${NC}"
        done
        echo
        echo -e "${BLUE}Install yt-dlp from: https://github.com/yt-dlp/yt-dlp${NC}"
        exit 1
    fi
}

# Setup directories
setup_directories() {
    mkdir -p "$MUSIC_DIR"
    for src in youtube soundcloud other; do
        mkdir -p "$MUSIC_DIR/$src/audio/playlists"
        mkdir -p "$MUSIC_DIR/$src/audio/singles"
        mkdir -p "$MUSIC_DIR/$src/video/playlists"
        mkdir -p "$MUSIC_DIR/$src/video/singles"
    done
}

# Show fancy header
show_header() {
    clear
    echo -e "${PURPLE}"
    cat << "HEADER"
╔══════════════════════════════════════════════════════════╗
║              🎵 YouTube-DL Audio TUI Enhanced            ║
║              Organized Audio/Video Downloader             ║
╚══════════════════════════════════════════════════════════╝
HEADER
    echo -e "${NC}"
}

# Main menu
main_menu() {
    show_header
    echo -e "${CYAN}📋 Main Menu${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo
    echo -e "  ${GREEN}1${NC}) ${BOLD}Download${NC} - Download audio or video from URL"
    echo -e "  ${GREEN}2${NC}) ${BOLD}Exit${NC} - Quit application"
    echo
    
    read -p "$(echo -e "${GREEN}🎯 Select option (1-2): ${NC}")" menu_choice
    
    case $menu_choice in
        1) download_workflow ;;
        2) 
            echo -e "${CYAN}👋 Thanks for using ytdlp-tui-enhanced!${NC}"
            exit 0
            ;;
        *)
            echo -e "${RED}❌ Invalid choice!${NC}"
            sleep 1
            ;;
    esac
}

# Get URL with fancy prompt
get_url() {
    show_header
    echo -e "${CYAN}📥 Enter Video/Playlist URL${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo -e "${YELLOW}Supported: YouTube, SoundCloud, Bandcamp, etc.${NC}"
    echo
    read -p "$(echo -e "${GREEN}🔗 URL: ${NC}")" url
    
    if [ -z "$url" ]; then
        echo -e "${RED}❌ URL cannot be empty!${NC}"
        sleep 2
        return 1
    fi
    
    # Detect source
    DOWNLOAD_META[source]=$(detect_source "$url")
    
    # Check if playlist
    if is_playlist "$url"; then
        DOWNLOAD_META[type]="playlist"
    else
        DOWNLOAD_META[type]="single"
    fi
    
    echo -e "${GREEN}✅ Detected: ${DOWNLOAD_META[source]} ${DOWNLOAD_META[type]}${NC}"
    sleep 1
    return 0
}

# Select whether to download audio-only or video
select_mode() {
    case $UI_MODE in
        "fzf")
            select_mode_fzf
            ;;
        "whiptail")
            select_mode_whiptail
            ;;
        "basic")
            select_mode_basic
            ;;
    esac
}

select_mode_fzf() {
    show_header
    echo -e "${CYAN}🎛️  Select Media Type${NC}"
    echo -e "${BLUE}=========================================${NC}"
    
    local choice=$(printf "audio\tAudio only (mp3/m4a/opus/flac/wav)\nvideo\tVideo (mp4/m4a/mkv/webm)" | fzf --height=40% --header="Download audio or video?" --delimiter=$'\t' --with-nth=1,2 | cut -f1)
    
    DOWNLOAD_META[mode]="${choice:-audio}"
}

select_mode_whiptail() {
    local choice=$(whiptail --title "Select Media Type" --menu "Download audio or video?" 12 60 2 \
        "audio" "Audio only (mp3/m4a/opus/flac/wav)" \
        "video" "Video (mp4/m4a/mkv/webm)" 3>&1 1>&2 2>&3)
    
    if [ $? -ne 0 ] || [ -z "$choice" ]; then
        choice="audio"
    fi
    DOWNLOAD_META[mode]="$choice"
}

select_mode_basic() {
    show_header
    echo -e "${CYAN}🎛️  Select Media Type${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo
    echo -e "  ${GREEN}1${NC}) ${BOLD}Audio${NC} - Extract audio only"
    echo -e "  ${GREEN}2${NC}) ${BOLD}Video${NC} - Download video (with audio)"
    echo
    
    while true; do
        read -p "$(echo -e "${GREEN}🎯 Select type (1-2): ${NC}")" mode_choice
        case $mode_choice in
            1) DOWNLOAD_META[mode]="audio"; break ;;
            2) DOWNLOAD_META[mode]="video"; break ;;
            *) echo -e "${RED}❌ Invalid choice! Please enter 1-2${NC}" ;;
        esac
    done
}

# Select format based on UI mode and media type (audio/video)
select_format() {
    if [ "${DOWNLOAD_META[mode]}" = "video" ]; then
        case $UI_MODE in
            "fzf")
                select_video_format_fzf
                ;;
            "whiptail")
                select_video_format_whiptail
                ;;
            "basic")
                select_video_format_basic
                ;;
        esac
    else
        case $UI_MODE in
            "fzf")
                select_format_fzf
                ;;
            "whiptail")
                select_format_whiptail
                ;;
            "basic")
                select_format_basic
                ;;
        esac
    fi
}

select_format_fzf() {
    show_header
    echo -e "${CYAN}🎼 Select Audio Format${NC}"
    echo -e "${BLUE}=========================================${NC}"
    
    format=$(printf "mp3\tMP3 format (most compatible)\nm4a\tM4A format (Apple devices)\nopus\tOpus format (high quality)\nflac\tFLAC format (lossless)\nwav\tWAV format (uncompressed)" | fzf --height=40% --header="Select audio format:" --delimiter=$'\t' --with-nth=1,2 | cut -f1)
    
    if [ -z "$format" ]; then
        echo -e "${RED}No format selected, using mp3${NC}"
        format="mp3"
    fi
}

select_format_whiptail() {
    format=$(whiptail --title "Select Audio Format" --menu "Choose download format:" 15 50 5 \
        "mp3" "MP3 format (most compatible)" \
        "m4a" "M4A format (Apple devices)" \
        "opus" "Opus format (high quality)" \
        "flac" "FLAC format (lossless)" \
        "wav" "WAV format (uncompressed)" 3>&1 1>&2 2>&3)
    
    if [ $? -ne 0 ] || [ -z "$format" ]; then
        format="mp3"
    fi
}

select_format_basic() {
    show_header
    echo -e "${CYAN}🎼 Select Audio Format${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo
    echo -e "  ${GREEN}1${NC}) ${BOLD}mp3${NC}  - MP3 format (most compatible)"
    echo -e "  ${GREEN}2${NC}) ${BOLD}m4a${NC}  - M4A format (Apple devices)"
    echo -e "  ${GREEN}3${NC}) ${BOLD}opus${NC} - Opus format (high quality)"
    echo -e "  ${GREEN}4${NC}) ${BOLD}flac${NC} - FLAC format (lossless)"
    echo -e "  ${GREEN}5${NC}) ${BOLD}wav${NC}  - WAV format (uncompressed)"
    echo
    
    while true; do
        read -p "$(echo -e "${GREEN}🎵 Select format (1-5): ${NC}")" format_choice
        
        case $format_choice in
            1) format="mp3"; break ;;
            2) format="m4a"; break ;;
            3) format="opus"; break ;;
            4) format="flac"; break ;;
            5) format="wav"; break ;;
            *) echo -e "${RED}❌ Invalid choice! Please enter 1-5${NC}" ;;
        esac
    done
}

select_video_format_fzf() {
    show_header
    echo -e "${CYAN}🎬 Select Video Format${NC}"
    echo -e "${BLUE}=========================================${NC}"
    
    format=$(printf "mp4\tMP4 format (most compatible)\nm4a\tM4A container (audio+video, Apple)\nmkv\tMKV format (best quality/codec match)\nwebm\tWebM format (open, efficient)" | fzf --height=40% --header="Select video format:" --delimiter=$'\t' --with-nth=1,2 | cut -f1)
    
    if [ -z "$format" ]; then
        echo -e "${RED}No format selected, using mp4${NC}"
        format="mp4"
    fi
}

select_video_format_whiptail() {
    format=$(whiptail --title "Select Video Format" --menu "Choose download format:" 15 55 4 \
        "mp4" "MP4 format (most compatible)" \
        "m4a" "M4A container (audio+video, Apple)" \
        "mkv" "MKV format (best quality/codec match)" \
        "webm" "WebM format (open, efficient)" 3>&1 1>&2 2>&3)
    
    if [ $? -ne 0 ] || [ -z "$format" ]; then
        format="mp4"
    fi
}

select_video_format_basic() {
    show_header
    echo -e "${CYAN}🎬 Select Video Format${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo
    echo -e "  ${GREEN}1${NC}) ${BOLD}mp4${NC}  - MP4 format (most compatible)"
    echo -e "  ${GREEN}2${NC}) ${BOLD}m4a${NC}  - M4A container (audio+video, Apple)"
    echo -e "  ${GREEN}3${NC}) ${BOLD}mkv${NC}  - MKV format (best quality/codec match)"
    echo -e "  ${GREEN}4${NC}) ${BOLD}webm${NC} - WebM format (open, efficient)"
    echo
    
    while true; do
        read -p "$(echo -e "${GREEN}🎬 Select format (1-4): ${NC}")" format_choice
        
        case $format_choice in
            1) format="mp4"; break ;;
            2) format="m4a"; break ;;
            3) format="mkv"; break ;;
            4) format="webm"; break ;;
            *) echo -e "${RED}❌ Invalid choice! Please enter 1-4${NC}" ;;
        esac
    done
}

# Build the yt-dlp download args array based on DOWNLOAD_META[mode] and $format
# Populates the global array DLP_ARGS
build_dlp_args() {
    DLP_ARGS=()
    if [ "${DOWNLOAD_META[mode]}" = "video" ]; then
        # Always grab the best available video+audio streams regardless of
        # their native container, then let --merge-output-format remux/
        # transcode into the chosen format. Filtering streams by ext=$format
        # here was the bug: mkv (and often mp4/webm) rarely occurs as a
        # native stream extension, so the filter matched nothing and fell
        # back to the single low-res pre-muxed "best" format.
        DLP_ARGS+=(-f "bestvideo+bestaudio/best")
        DLP_ARGS+=(--merge-output-format "$format")
        DLP_ARGS+=(--embed-metadata --embed-thumbnail)
    else
        DLP_ARGS+=(-x --audio-format "$format" --audio-quality 0)
        DLP_ARGS+=(--embed-metadata --embed-thumbnail)
    fi
}

# Get playlist info
get_playlist_info() {
    echo -e "${YELLOW}📋 Fetching playlist info...${NC}"
    
    # Get playlist title
    playlist_title=$(yt-dlp --flat-playlist --print "%(playlist_title)s" "$url" 2>/dev/null | head -1)
    
    if [ -z "$playlist_title" ]; then
        playlist_title="Unknown Playlist"
    fi
    
    DOWNLOAD_META[playlist_title]="$playlist_title"
    
    # Get video info
    playlist_info=$(yt-dlp --flat-playlist --print "%(title)s|||%(duration)s|||%(uploader)s" "$url" 2>/dev/null)
    
    if [ $? -ne 0 ] || [ -z "$playlist_info" ]; then
        return 1
    fi
    
    # Parse into arrays
    IFS=$'\n' read -d '' -r -a video_data <<< "$playlist_info"
    
    titles=()
    durations=()
    uploaders=()
    
    for line in "${video_data[@]}"; do
        IFS='|||' read -r title duration uploader <<< "$line"
        titles+=("$title")
        durations+=("$duration")
        uploaders+=("$uploader")
    done
    
    return 0
}

# Select playlist items based on UI mode
select_playlist_items() {
    case $UI_MODE in
        "fzf")
            select_playlist_items_fzf
            ;;
        "whiptail")
            select_playlist_items_whiptail
            ;;
        "basic")
            select_playlist_items_basic
            ;;
    esac
}

select_playlist_items_fzf() {
    show_header
    echo -e "${CYAN}🎵 Select Playlist Items${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo -e "${PURPLE}Playlist: ${DOWNLOAD_META[playlist_title]}${NC}"
    echo
    
    # Prepare data for fzf
    > /tmp/playlist_items.txt
    for i in "${!titles[@]}"; do
        duration=${durations[$i]:-"Unknown"}
        uploader=${uploaders[$i]:-"Unknown"}
        printf "%-3s %-60s %-8s %s\n" "$((i+1))" "${titles[$i]}" "$duration" "$uploader" >> /tmp/playlist_items.txt
    done
    
    selected=$(cat /tmp/playlist_items.txt | fzf --multi --height=80% --header="Select videos (Tab to select, Enter to confirm, or ESC for all)" | awk '{print $1}')
    
    if [ -z "$selected" ]; then
        echo -e "${YELLOW}No items selected, downloading entire playlist${NC}"
        return 0
    fi
    
    # Convert to comma-separated list
    DOWNLOAD_META[selection]=$(echo "$selected" | tr '\n' ',' | sed 's/,$//')
    return 1
}

select_playlist_items_whiptail() {
    # Build whiptail menu items
    menu_items=()
    for i in "${!titles[@]}"; do
        menu_items+=("$((i+1))" "${titles[$i]:0:50}" "OFF")
    done
    
    selected=$(whiptail --title "Select Videos" --checklist "Choose videos to download (Space to select, Enter to confirm):" 20 70 12 "${menu_items[@]}" 3>&1 1>&2 2>&3)
    
    if [ $? -ne 0 ] || [ -z "$selected" ]; then
        echo -e "${YELLOW}No items selected, downloading entire playlist${NC}"
        return 0
    fi
    
    # Parse whiptail output and convert to comma-separated
    DOWNLOAD_META[selection]=$(echo "$selected" | sed 's/"//g' | sed 's/ /,/g')
    return 1
}

select_playlist_items_basic() {
    show_header
    echo -e "${CYAN}🎵 Playlist Items${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo -e "${PURPLE}Playlist: ${DOWNLOAD_META[playlist_title]}${NC}"
    echo
    
    for i in "${!titles[@]}"; do
        duration=${durations[$i]:-"Unknown"}
        echo -e "  ${GREEN}$((i+1))${NC}) ${titles[$i]}"
        echo -e "      ${BLUE}⏱ ${duration}s${NC} | ${PURPLE}👤 ${uploaders[$i]}${NC}"
    done
    
    echo
    echo -e "${YELLOW}Enter video numbers (e.g., 1 3 5) or 'all' for everything:${NC}"
    read -p "$(echo -e "${GREEN}🎯 Selection: ${NC}")" selection
    
    if [ "$selection" = "all" ] || [ -z "$selection" ]; then
        return 0
    else
        # Convert space-separated to comma-separated
        DOWNLOAD_META[selection]=$(echo "$selection" | tr ' ' ',')
        return 1
    fi
}

# Download single video
download_single() {
    local source="${DOWNLOAD_META[source]}"
    local media_mode="${DOWNLOAD_META[mode]:-audio}"
    local save_dir="$MUSIC_DIR/$source/$media_mode/singles"
    
    # Get video title first
    echo -e "${YELLOW}🔍 Fetching video info...${NC}"
    video_title=$(yt-dlp --print "%(title)s" "$url" 2>/dev/null | head -1)
    
    if [ -z "$video_title" ]; then
        video_title="Unknown Title"
    fi
    
    # Get custom name
    custom_name=$(get_custom_name "$video_title")

    # Sanitize for use as a filename (strip characters that are risky or
    # illegal in filenames; keep spaces/unicode)
    local safe_name=$(echo "$custom_name" | sed 's/[\/:\*?"<>|]//g')
    if [ -z "$safe_name" ]; then
        safe_name="$video_title"
    fi
    
    show_header
    echo -e "${CYAN}🚀 Starting Download${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo -e "${GREEN}📁 Location:${NC} $save_dir"
    echo -e "${GREEN}🎬 Type:${NC} $media_mode"
    echo -e "${GREEN}🎵 Format:${NC} $format"
    echo -e "${GREEN}📝 Name:${NC} $custom_name"
    echo -e "${GREEN}🔗 URL:${NC} $url"
    echo
    echo -e "${YELLOW}⬇️  Downloading...${NC}"
    echo "──────────────────────────────────────────────────"
    
    mkdir -p "$save_dir"
    cd "$save_dir"
    
    build_dlp_args
    yt-dlp "${DLP_ARGS[@]}" \
        -o "${safe_name}.%(ext)s" \
        "$url"
    
    local result=$?
    
    if [ $result -eq 0 ]; then
        echo
        echo "──────────────────────────────────────────────────"
        echo -e "${GREEN}✅ Download completed successfully!${NC}"
        echo -e "${BLUE}📁 Files saved to: $save_dir${NC}"
    else
        echo
        echo "──────────────────────────────────────────────────"
        echo -e "${RED}❌ Download failed with error code: $result${NC}"
    fi
}

# Download entire playlist
download_entire_playlist() {
    local source="${DOWNLOAD_META[source]}"
    local media_mode="${DOWNLOAD_META[mode]:-audio}"
    local playlist_title="${DOWNLOAD_META[playlist_title]}"
    local save_dir="$MUSIC_DIR/$source/$media_mode/playlists"
    
    # Get custom name for playlist
    custom_name=$(get_custom_name "$playlist_title")
    
    # Create sanitized folder name
    local folder_name=$(echo "$custom_name" | sed 's/[^a-zA-Z0-9 _-]//g')
    local full_save_dir="$save_dir/$folder_name"
    
    show_header
    echo -e "${CYAN}🚀 Downloading Entire Playlist${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo -e "${GREEN}📁 Location:${NC} $full_save_dir"
    echo -e "${GREEN}🎬 Type:${NC} $media_mode"
    echo -e "${GREEN}🎵 Format:${NC} $format"
    echo -e "${GREEN}📝 Name:${NC} $custom_name"
    echo -e "${GREEN}📋 Videos:${NC} ${#titles[@]}"
    echo -e "${GREEN}🔗 URL:${NC} $url"
    echo
    echo -e "${YELLOW}⬇️  Downloading...${NC}"
    echo "──────────────────────────────────────────────────"
    
    mkdir -p "$full_save_dir"
    cd "$full_save_dir"
    
    build_dlp_args
    yt-dlp "${DLP_ARGS[@]}" \
        -o "%(title)s.%(ext)s" \
        "$url"
    
    local result=$?
    
    if [ $result -eq 0 ]; then
        echo
        echo "──────────────────────────────────────────────────"
        echo -e "${GREEN}✅ Playlist download completed successfully!${NC}"
        echo -e "${BLUE}📁 Files saved to: $full_save_dir${NC}"
    else
        echo
        echo "──────────────────────────────────────────────────"
        echo -e "${RED}❌ Download failed with error code: $result${NC}"
    fi
}

# Download selected videos from playlist
download_selected_videos() {
    local source="${DOWNLOAD_META[source]}"
    local media_mode="${DOWNLOAD_META[mode]:-audio}"
    local playlist_title="${DOWNLOAD_META[playlist_title]}"
    local selection="${DOWNLOAD_META[selection]}"
    local save_dir="$MUSIC_DIR/$source/$media_mode/playlists"
    
    # Get custom name for selection
    custom_name=$(get_custom_name "$playlist_title (Selected)")
    
    # Create sanitized folder name
    local folder_name=$(echo "$custom_name" | sed 's/[^a-zA-Z0-9 _-]//g')
    local full_save_dir="$save_dir/$folder_name"
    
    show_header
    echo -e "${CYAN}🚀 Downloading Selected Videos${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo -e "${GREEN}📁 Location:${NC} $full_save_dir"
    echo -e "${GREEN}🎬 Type:${NC} $media_mode"
    echo -e "${GREEN}🎵 Format:${NC} $format"
    echo -e "${GREEN}📝 Name:${NC} $custom_name"
    echo -e "${GREEN}🎯 Selected:${NC} $selection"
    echo -e "${GREEN}🔗 URL:${NC} $url"
    echo
    echo -e "${YELLOW}⬇️  Downloading...${NC}"
    echo "──────────────────────────────────────────────────"
    
    mkdir -p "$full_save_dir"
    cd "$full_save_dir"
    
    build_dlp_args
    yt-dlp "${DLP_ARGS[@]}" \
        --playlist-items "$selection" \
        -o "%(title)s.%(ext)s" \
        "$url"
    
    local result=$?
    
    if [ $result -eq 0 ]; then
        echo
        echo "──────────────────────────────────────────────────"
        echo -e "${GREEN}✅ Selected videos downloaded successfully!${NC}"
        echo -e "${BLUE}📁 Files saved to: $full_save_dir${NC}"
    else
        echo
        echo "──────────────────────────────────────────────────"
        echo -e "${RED}❌ Download failed with error code: $result${NC}"
    fi
}

# Download workflow
download_workflow() {
    # Get URL
    if ! get_url; then
        return
    fi
    
    # Select audio or video
    select_mode
    
    # Select format
    select_format
    
    # Handle based on type
    if [ "${DOWNLOAD_META[type]}" = "playlist" ]; then
        if get_playlist_info; then
            if select_playlist_items; then
                # User wants entire playlist
                download_entire_playlist
            else
                # User selected specific videos
                download_selected_videos
            fi
        else
            echo -e "${RED}❌ Failed to fetch playlist info${NC}"
            echo -e "${YELLOW}Trying to download as single video...${NC}"
            DOWNLOAD_META[type]="single"
            download_single
        fi
    else
        download_single
    fi
    
    echo
    read -p "$(echo -e "${GREEN}Press Enter to continue...${NC}")"
}

# Main function
main() {
    detect_ui
    check_dependencies
    setup_directories
    
    while true; do
        main_menu
    done
}

# Handle Ctrl+C gracefully
trap 'echo -e "\n${RED}👋 Exiting...${NC}"; exit 0' INT

# Run main function
main
