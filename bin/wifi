#!bin/bash

while :; do
    sum=0 n=0; 
    for h in \
        1.1.1.1 \
        8.8.8.8 \
        9.9.9.9 \
        208.67.222.222; 
        do p=$(ping -c1 -W1 -q "$h" 2>/dev/null | awk -F'/' '/^rtt|^round-trip/{print $5}');
        [ -n "$p" ] && sum=$(awk "BEGIN{print $sum+$p}") && n=$((n+1));
    done;
        [ "$n" -gt 0 ] && awk "BEGIN{printf \"%.0f ms\n\", $sum/$n}" || echo "N/A"
    sleep 1
done
